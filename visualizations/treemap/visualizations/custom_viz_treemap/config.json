{
  "showTitleAndDescription": true,
  "includeInToolbar": true,
  "includeInVizSwitcher": true,
  "showDrilldown": false,
  "canSetTokens": [],
  "hasEventHandlers": false,
  "config": {
    "name": "Custom Viz Treemap",
    "description": "A hierarchical treemap with squarified layout and click-to-drill navigation",
    "category": "Custom",
    "icon": null,
    "dataContract": {
      "requiredDataSources": ["primary"],
      "optionalDataSources": []
    },
    "size": {
      "initialWidth": 640,
      "initialHeight": 420
    },
    "optionsSchema": {
      "valueField": { "type": "string", "default": "" },
      "level1Field": { "type": "string", "default": "" },
      "level2Field": { "type": "string", "default": "" },
      "level3Field": { "type": "string", "default": "" },

      "color1": { "type": "string", "default": "#4c9be8" },
      "color2": { "type": "string", "default": "#26c2a5" },
      "color3": { "type": "string", "default": "#f2b53c" },
      "color4": { "type": "string", "default": "#f2653f" },
      "color5": { "type": "string", "default": "#a97bf0" },
      "color6": { "type": "string", "default": "#f75d97" },
      "color7": { "type": "string", "default": "#5ed4f0" },
      "color8": { "type": "string", "default": "#94a3b5" },
      "shadeChildren": { "type": "boolean", "default": true },

      "maxDepth": { "type": "number", "default": 2 },
      "maxTiles": { "type": "number", "default": 300 },
      "tileGap": { "type": "number", "default": 2 },
      "tileRadius": { "type": "number", "default": 3 },

      "showLabels": { "type": "boolean", "default": true },
      "showValues": { "type": "boolean", "default": true },
      "showPercent": { "type": "boolean", "default": false },
      "showGroupHeaders": { "type": "boolean", "default": true },
      "showBreadcrumb": { "type": "boolean", "default": true },
      "showLegend": { "type": "boolean", "default": false },
      "enableDrilldown": { "type": "boolean", "default": true },
      "animate": { "type": "boolean", "default": true },

      "valueDecimals": { "type": "number", "default": 0 },
      "abbreviateValue": { "type": "boolean", "default": true },

      "drillPath": { "type": "string", "default": "" },

      "debug": { "type": "boolean", "default": false }
    },
    "editorConfig": [
      {
        "label": "データフィールド",
        "layout": [
          [{ "label": "値（面積）フィールド", "editor": "editor.columnSelector", "option": "valueField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "第1階層フィールド", "editor": "editor.columnSelector", "option": "level1Field", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "第2階層フィールド", "editor": "editor.columnSelector", "option": "level2Field", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "第3階層フィールド", "editor": "editor.columnSelector", "option": "level3Field", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }]
        ]
      },
      {
        "label": "配色",
        "layout": [
          [{ "label": "色1", "editor": "editor.color", "option": "color1" }],
          [{ "label": "色2", "editor": "editor.color", "option": "color2" }],
          [{ "label": "色3", "editor": "editor.color", "option": "color3" }],
          [{ "label": "色4", "editor": "editor.color", "option": "color4" }],
          [{ "label": "色5", "editor": "editor.color", "option": "color5" }],
          [{ "label": "色6", "editor": "editor.color", "option": "color6" }],
          [{ "label": "色7", "editor": "editor.color", "option": "color7" }],
          [{ "label": "色8（以降は繰り返し）", "editor": "editor.color", "option": "color8" }],
          [{ "label": "子タイルを濃淡で塗り分け", "editor": "editor.checkbox", "option": "shadeChildren" }]
        ]
      },
      {
        "label": "階層とタイル",
        "layout": [
          [{ "label": "同時に表示する階層数（1〜3）", "editor": "editor.number", "option": "maxDepth" }],
          [{ "label": "タイルの最大数（超過分は「その他」に集約）", "editor": "editor.number", "option": "maxTiles" }],
          [{ "label": "タイルの間隔（px）", "editor": "editor.number", "option": "tileGap" }],
          [{ "label": "タイルの角丸（px）", "editor": "editor.number", "option": "tileRadius" }]
        ]
      },
      {
        "label": "表示",
        "layout": [
          [{ "label": "タイル名を表示", "editor": "editor.checkbox", "option": "showLabels" }],
          [{ "label": "値を表示", "editor": "editor.checkbox", "option": "showValues" }],
          [{ "label": "全体に占める割合を表示", "editor": "editor.checkbox", "option": "showPercent" }],
          [{ "label": "グループ見出しを表示", "editor": "editor.checkbox", "option": "showGroupHeaders" }],
          [{ "label": "パンくずリストを表示", "editor": "editor.checkbox", "option": "showBreadcrumb" }],
          [{ "label": "凡例を表示", "editor": "editor.checkbox", "option": "showLegend" }],
          [{ "label": "クリックで下の階層へ掘り下げる", "editor": "editor.checkbox", "option": "enableDrilldown" }],
          [{ "label": "フェードインアニメーション", "editor": "editor.checkbox", "option": "animate" }]
        ]
      },
      {
        "label": "数値",
        "layout": [
          [{ "label": "小数点以下の桁数", "editor": "editor.number", "option": "valueDecimals" }],
          [{ "label": "数値を省略表記（1.5M など）", "editor": "editor.checkbox", "option": "abbreviateValue" }]
        ]
      },
      {
        "label": "デバッグ",
        "layout": [
          [{ "label": "オプションのデバッグ表示", "editor": "editor.checkbox", "option": "debug" }]
        ]
      }
    ],
    "defaultContext": {}
  }
}
