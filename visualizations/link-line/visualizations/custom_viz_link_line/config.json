{
  "showTitleAndDescription": false,
  "includeInToolbar": true,
  "includeInVizSwitcher": true,
  "showDrilldown": true,
  "canSetTokens": ["dynamic", "static"],
  "hasEventHandlers": true,
  "config": {
    "name": "Link Line",
    "description": "An editable connector line between servers. Bend and drag the line in view mode; the color follows the value ranges configured in the editor panel",
    "category": "Custom",
    "icon": null,
    "events": {
      "line.click": { "description": "triggered when user clicks the connector line" }
    },
    "supports": ["events"],
    "dataContract": {
      "requiredDataSources": ["primary"],
      "optionalDataSources": []
    },
    "size": {
      "initialWidth": 360,
      "initialHeight": 140
    },
    "optionsSchema": {
      "valueField": { "type": "string", "default": "" },

      "linePoints": { "type": "string", "default": "" },
      "cornerRadius": { "type": "number", "default": 14 },
      "allowViewEdit": { "type": "boolean", "default": true },

      "styleMode": { "type": "string", "default": "flat" },
      "lineWidth": { "type": "number", "default": 6 },
      "lineGradient": { "type": "boolean", "default": true },
      "dashLength": { "type": "number", "default": 0 },
      "flowSpeed": { "type": "number", "default": 0 },
      "pulseCaps": { "type": "boolean", "default": false },
      "lineOpacity": { "type": "number", "default": 100 },

      "showEndCaps": { "type": "boolean", "default": true },
      "arrowHead": { "type": "boolean", "default": false },
      "showValue": { "type": "boolean", "default": true },
      "valueDecimals": { "type": "number", "default": 0 },
      "unitLabel": { "type": "string", "default": "" },
      "linkLabel": { "type": "string", "default": "" },
      "flowDirection": { "type": "string", "default": "forward" },
      "colorMode": { "type": "string", "default": "range" },
      "matchColors": {
        "default": [],
        "anyOf": [
          { "type": "array", "items": { "type": "string" } },
          { "type": "string", "pattern": "^>.*" }
        ]
      },

      "colorBands": {
        "default": [
          { "from": 0, "to": 40, "value": "#53a051" },
          { "from": 40, "to": 70, "value": "#f8be34" },
          { "from": 70, "to": 90, "value": "#f1813f" },
          { "from": 90, "to": null, "value": "#dc4e41" }
        ],
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": { "type": ["number", "null"] },
                "to": { "type": ["number", "null"] },
                "value": { "type": "string" }
              },
              "required": ["value"],
              "additionalProperties": false
            }
          },
          { "type": "string", "pattern": "^>.*" }
        ]
      }
    },
    "editorConfig": [
      {
        "label": "データフィールド",
        "layout": [
          [{ "label": "値フィールド（未指定なら数値を含む最後の列・最終行）", "editor": "editor.columnSelector", "option": "valueField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }]
        ]
      },
      {
        "label": "線の形状（線は表示画面の「✎ 線を編集」でドラッグ編集し、その後この編集画面で保存して確定。編集モード中はドラッグ不可）",
        "layout": [
          [{ "label": "線編集を許可", "editor": "editor.checkbox", "option": "allowViewEdit" }],
          [{ "label": "折れ角の丸み（px、0で角ばった折れ線）", "editor": "editor.number", "option": "cornerRadius" }]
        ]
      },
      {
        "label": "線の色",
        "layout": [
          [{ "label": "色分けモード", "editor": "editor.select", "option": "colorMode", "editorProps": { "values": [
            { "label": "値の範囲で色分け（数値）", "value": "range" },
            { "label": "文字列の一致で色分け（OK / NG など）", "value": "match" }
          ] } }],
          [{ "label": "値の範囲と色（モードが「値の範囲」のとき使用。＋で範囲を追加。上限/下限なしの範囲も作れます）", "editor": "editor.threshold", "option": "colorBands", "editorProps": { "openRanges": true, "isTogglable": false } }],
          [{ "label": "値と色の対応（モードが「文字列の一致」のとき使用。1行に1つ「値|色」の形式。例: OK|#53a051／NG|#dc4e41。大文字小文字は区別しません）", "editor": "editor.arrayOfStrings", "option": "matchColors", "editorProps": { "labelPosition": "top", "themes": {} } }]
        ]
      },
      {
        "label": "質感",
        "layout": [
          [
            {
              "label": "質感",
              "editor": "editor.select",
              "option": "styleMode",
              "editorProps": {
                "values": [
                  { "label": "フラット", "value": "flat" },
                  { "label": "ソフトシャドウ", "value": "shadow" },
                  { "label": "ネオン発光", "value": "neon" },
                  { "label": "立体パイプ", "value": "pipe" }
                ]
              }
            }
          ],
          [{ "label": "線の太さ（px）", "editor": "editor.number", "option": "lineWidth" }],
          [{ "label": "グラデーション", "editor": "editor.checkbox", "option": "lineGradient" }],
          [{ "label": "破線の長さ（px、0で実線）", "editor": "editor.number", "option": "dashLength" }],
          [{ "label": "光の帯の速度（0で停止）", "editor": "editor.slider", "option": "flowSpeed", "editorProps": { "min": 0, "max": 10, "step": 0.5 } }],
          [{ "label": "光の帯の向き", "editor": "editor.select", "option": "flowDirection", "editorProps": { "values": [
            { "label": "順方向（始点 → 終点）", "value": "forward" },
            { "label": "逆方向（終点 → 始点）", "value": "reverse" },
            { "label": "双方向", "value": "both" }
          ] } }],
          [{ "label": "端点をパルス発光", "editor": "editor.checkbox", "option": "pulseCaps" }],
          [{ "label": "不透明度（%）", "editor": "editor.slider", "option": "lineOpacity", "editorProps": { "min": 10, "max": 100, "step": 5 } }]
        ]
      },
      {
        "label": "端点・値ラベル",
        "layout": [
          [{ "label": "両端に丸端子", "editor": "editor.checkbox", "option": "showEndCaps" }],
          [{ "label": "終点に矢印を表示", "editor": "editor.checkbox", "option": "arrowHead" }],
          [{ "label": "値ラベルを線の中央に表示", "editor": "editor.checkbox", "option": "showValue" }],
          [{ "label": "小数点以下の桁数", "editor": "editor.number", "option": "valueDecimals" }],
          [{ "label": "単位（値の後ろに表示。例: ms／%。空欄で非表示）", "editor": "editor.text", "option": "unitLabel" }],
          [{ "label": "接続名（値の前に表示。例: DB → App。空欄で非表示）", "editor": "editor.text", "option": "linkLabel" }]
        ]
      }
    ],
    "defaultContext": {}
  }
}
