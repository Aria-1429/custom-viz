{
  "showTitleAndDescription": true,
  "includeInToolbar": true,
  "includeInVizSwitcher": true,
  "showDrilldown": false,
  "canSetTokens": [],
  "hasEventHandlers": false,
  "config": {
    "name": "Custom Viz Timeline Swimlane",
    "description": "An event timeline with per-entity swimlanes, duration bars and brush-based time range selection",
    "category": "Custom",
    "icon": null,
    "dataContract": {
      "requiredDataSources": ["primary"],
      "optionalDataSources": []
    },
    "size": {
      "initialWidth": 720,
      "initialHeight": 400
    },
    "optionsSchema": {
      "laneField": { "type": "string", "default": "" },
      "startField": { "type": "string", "default": "" },
      "endField": { "type": "string", "default": "" },
      "categoryField": { "type": "string", "default": "" },
      "labelField": { "type": "string", "default": "" },

      "seriesColors": {
        "default": ["#4c9be8", "#26c2a5", "#f2b53c", "#f2653f", "#a97bf0", "#f75d97", "#5ed4f0", "#94a3b5"],
        "anyOf": [
          { "type": "array", "items": { "type": "string" } },
          { "type": "string", "pattern": "^>.*" }
        ]
      },

      "sortLanes": { "type": "string", "default": "count" },
      "maxLanes": { "type": "number", "default": 40 },
      "autoLaneHeight": { "type": "boolean", "default": true },
      "laneMaxHeight": { "type": "number", "default": 60 },
      "laneHeight": { "type": "number", "default": 26 },
      "minBarWidth": { "type": "number", "default": 3 },
      "barRadius": { "type": "number", "default": 3 },
      "barOpacity": { "type": "number", "default": 0.9 },

      "showLaneLabels": { "type": "boolean", "default": true },
      "showLaneCount": { "type": "boolean", "default": true },
      "showAxis": { "type": "boolean", "default": true },
      "showGrid": { "type": "boolean", "default": true },
      "showLegend": { "type": "boolean", "default": true },
      "showBarLabels": { "type": "boolean", "default": false },
      "stripeLanes": { "type": "boolean", "default": false },
      "showCrosshair": { "type": "boolean", "default": true },
      "showNowLine": { "type": "boolean", "default": false },
      "animate": { "type": "boolean", "default": true },

      "enableBrush": { "type": "boolean", "default": true },
      "brushStart": { "type": "number" },
      "brushEnd": { "type": "number" },

      "rangeStart": { "type": "string", "default": "" },
      "rangeEnd": { "type": "string", "default": "" },
      "padRangePercent": { "type": "number", "default": 2 }
    },
    "editorConfig": [
      {
        "label": "データフィールド",
        "layout": [
          [{ "label": "レーン（縦軸）フィールド", "editor": "editor.columnSelector", "option": "laneField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "開始時刻フィールド", "editor": "editor.columnSelector", "option": "startField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "終了時刻フィールド（省略時は点イベント）", "editor": "editor.columnSelector", "option": "endField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "分類（色分け）フィールド", "editor": "editor.columnSelector", "option": "categoryField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }],
          [{ "label": "ラベルフィールド（ツールチップ用）", "editor": "editor.columnSelector", "option": "labelField", "context": "valuesContext", "editorProps": { "dataSourceKey": "primary" } }]
        ]
      },
      {
        "label": "分類の色",
        "layout": [
          [{ "label": "分類の色", "editor": "editor.seriesColors", "option": "seriesColors" }]
        ]
      },
      {
        "label": "レーン",
        "layout": [
          [{ "label": "レーンの高さを自動調整（パネルの高さいっぱいに広げる）", "editor": "editor.checkbox", "option": "autoLaneHeight" }],
          [{ "label": "レーンの高さ上限（px、自動調整オン時）", "editor": "editor.number", "option": "laneMaxHeight" }],
          [{ "label": "レーンの高さ（px、自動調整オフ時）", "editor": "editor.number", "option": "laneHeight" }],
          [{ "label": "レーンの最大数（超過分は省略）", "editor": "editor.number", "option": "maxLanes" }],
          [{ "label": "レーンを縞模様で塗り分け", "editor": "editor.checkbox", "option": "stripeLanes" }],
          [{ "label": "レーン名を表示", "editor": "editor.checkbox", "option": "showLaneLabels" }],
          [{ "label": "レーン名の横に件数を表示", "editor": "editor.checkbox", "option": "showLaneCount" }]
        ]
      },
      {
        "label": "イベントバー",
        "layout": [
          [{ "label": "バーの最小幅（px）", "editor": "editor.number", "option": "minBarWidth" }],
          [{ "label": "バーの角丸（px）", "editor": "editor.number", "option": "barRadius" }],
          [{ "label": "バーの不透明度（0〜1）", "editor": "editor.number", "option": "barOpacity" }],
          [{ "label": "バーにラベルを表示", "editor": "editor.checkbox", "option": "showBarLabels" }]
        ]
      },
      {
        "label": "時間軸",
        "layout": [
          [{ "label": "時間軸を表示", "editor": "editor.checkbox", "option": "showAxis" }],
          [{ "label": "グリッド線を表示", "editor": "editor.checkbox", "option": "showGrid" }],
          [{ "label": "カーソル位置に時刻の縦線を表示", "editor": "editor.checkbox", "option": "showCrosshair" }],
          [{ "label": "現在時刻の線を表示", "editor": "editor.checkbox", "option": "showNowLine" }],
          [{ "label": "時間軸の余白（％）", "editor": "editor.number", "option": "padRangePercent" }]
        ]
      },
      {
        "label": "表示範囲の固定（任意）",
        "layout": [
          [{ "label": "表示開始時刻（空欄=データ最小。例 2026-07-25 09:00）", "editor": "editor.text", "option": "rangeStart" }],
          [{ "label": "表示終了時刻（空欄=データ最大）", "editor": "editor.text", "option": "rangeEnd" }]
        ]
      },
      {
        "label": "表示",
        "layout": [
          [{ "label": "凡例を表示", "editor": "editor.checkbox", "option": "showLegend" }],
          [{ "label": "フェードインアニメーション", "editor": "editor.checkbox", "option": "animate" }],
          [{ "label": "ドラッグで時間範囲を絞り込む", "editor": "editor.checkbox", "option": "enableBrush" }]
        ]
      }
    ],
    "defaultContext": {}
  }
}
