            }
        },
        "ds_horizon_traffic": {
            "type": "ds.search",
            "name": "ds_horizon_traffic",
            "options": {
                "query": "| makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, site=\"東京DC\", mbps=820+260*sin(i/4)+random()%140 | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, site=\"大阪DC\", mbps=640+210*sin(i/5+1)+random()%120 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, site=\"名古屋拠点\", mbps=310+120*sin(i/3+2)+random()%80 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, site=\"福岡拠点\", mbps=280+95*sin(i/6)+random()%70 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, site=\"札幌拠点\", mbps=190+80*sin(i/4+3)+random()%60 ] | table _time site mbps",
