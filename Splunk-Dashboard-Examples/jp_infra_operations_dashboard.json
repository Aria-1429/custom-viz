        "ds_calendar": {
            "type": "ds.search",
            "name": "ds_calendar",
            "options": {
                "query": "| makeresults count=180 | streamstats count as i | eval day=strftime(relative_time(now(), \"-180d\") + i*86400, \"%Y-%m-%d\") | eval incidents=if(random()%100 < 62, 0, random()%6+1) | table day incidents",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_terrain": {
            "type": "ds.search",
            "name": "ds_terrain",
            "options": {
                "query": "| makeresults count=64 | streamstats count as i | eval rack=\"R\" . tostring(((i-1)%8)+1), node=\"N\" . tostring(floor((i-1)/8)+1) | eval load=38+34*sin(i/5)+22*cos(i/3)+random()%16 | table rack node load",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
