        "primary": "ds_board_report"
      },
      "options": {
        "severityField": "> primary | seriesByName('重要度')",
        "sortMode": "desc",
        "maxRows": 8,
        "severityMode": "string",
        "severityColors": [
          "#e8604c",
          "#e0a63c",
          "#d8b46a",
          "#3fbf7f",
          "#5b8def"
        ],
        "cellStyle": "pill",
        "rowBar": true,
        "zebra": true,
        "compact": true,
        "showSummary": true,
        "summaryLabelMode": "canonical",
        "topIcon": "highest",
        "autoHideColumns": true,
        "enableDrilldown": false,
        "backgroundColor": "transparent"
      }
    },
    "md_header_risk": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "# リスクと統制の状況\n##### RISK & CONTROL　—　フレームワーク成熟度・部門別リスク・統制の実効性",
        "fontColor": "#f0f3fa",
        "backgroundColor": "transparent"
      }
    },
    "md_footer_risk": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "###### 成熟度は NIST CSF の6機能に沿って自己評価。残存リスク額は発生確率 × 想定損失額で算定（いずれもサンプル値）",
        "fontColor": "#5b6880",
        "backgroundColor": "transparent"
      }
    },
    "viz_maturity": {
      "type": "custom_viz_radar_chart.custom_viz_radar_chart",
