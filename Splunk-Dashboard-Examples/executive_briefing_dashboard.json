{
  "title": "セキュリティ経営ダッシュボード",
  "description": "経営層向けのエグゼクティブ・ブリーフィング。1) 経営サマリー 2) リスクと統制 3) 投資対効果 の3タブ構成。全パネルは makeresults のサンプルデータで動作する。",
  "inputs": {
    "input_time": {
      "type": "input.timerange",
      "title": "報告期間",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "latest": "now"
          }
        }
      }
    },
    "visualizations": {
      "global": {
        "showLastUpdated": false,
        "showProgressBar": false
      }
    }
  },
  "visualizations": {
    "md_header_exec": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "# セキュリティ経営ダッシュボード\n##### EXECUTIVE SECURITY BRIEFING　—　全社セキュリティ体制の月次レビュー",
        "fontColor": "#f0f3fa",
        "backgroundColor": "transparent"
      }
    },
    "md_footer_exec": {
      "type": "splunk.markdown",
      "options": {
        "markdown": "###### 本ダッシュボードの数値はすべてサンプルデータ（makeresults）で生成しています　|　集計期間は右上の「報告期間」で切り替えられます",
        "fontColor": "#5b6880",
        "backgroundColor": "transparent"
      }
    },
    "kpi_posture": {
      "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
      "dataSources": {
        "primary": "ds_kpi_posture"
      },
      "options": {
        "labelField": "> primary | seriesByName('月')",
        "valueField": "> primary | seriesByName('スコア')",
        "titleText": "セキュリティ体制スコア",
        "deltaLabel": "前月比",
        "accentColor": "#d8b46a",
        "iconName": "shield",
        "showIcon": true,
        "showGlow": true,
        "showDelta": true,
        "deltaAsPercent": false,
        "deltaColorMode": "positiveGood",
        "sparkMode": "line",
        "valueDecimals": 0,
        "abbreviateValue": false,
        "animate": true,
        "bgOpacity": 18,
        "backgroundColor": "transparent"
      }
    },
    "kpi_incidents": {
      "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
      "dataSources": {
        "primary": "ds_kpi_incidents"
      },
      "options": {
        "labelField": "> primary | seriesByName('月')",
        "valueField": "> primary | seriesByName('件数')",
        "titleText": "重大インシデント（件）",
        "deltaLabel": "前月比",
        "accentColor": "#e8604c",
        "iconName": "alert",
        "showIcon": true,
        "showGlow": true,
        "showDelta": true,
        "deltaAsPercent": false,
        "deltaColorMode": "positiveBad",
        "sparkMode": "bars",
        "valueDecimals": 0,
        "abbreviateValue": false,
        "animate": true,
        "bgOpacity": 18,
        "backgroundColor": "transparent"
      }
    },
    "kpi_mttr": {
      "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
      "dataSources": {
        "primary": "ds_kpi_mttr"
      },
      "options": {
        "labelField": "> primary | seriesByName('月')",
        "valueField": "> primary | seriesByName('時間')",
        "titleText": "平均復旧時間 MTTR（時間）",
        "deltaLabel": "前月比",
        "accentColor": "#5b8def",
        "iconName": "clock",
        "showIcon": true,
        "showGlow": true,
        "showDelta": true,
        "deltaAsPercent": false,
        "deltaColorMode": "positiveBad",
        "sparkMode": "line",
        "valueDecimals": 1,
        "abbreviateValue": false,
        "animate": true,
        "bgOpacity": 18,
        "backgroundColor": "transparent"
      }
    },
    "kpi_compliance": {
      "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
      "dataSources": {
        "primary": "ds_kpi_compliance"
      },
      "options": {
        "labelField": "> primary | seriesByName('月')",
        "valueField": "> primary | seriesByName('適合率')",
        "titleText": "コンプライアンス適合率（%）",
        "deltaLabel": "前月比",
        "accentColor": "#2fc2ac",
        "iconName": "check",
        "showIcon": true,
        "showGlow": true,
        "showDelta": true,
        "deltaAsPercent": false,
        "deltaColorMode": "positiveGood",
        "sparkMode": "line",
        "valueDecimals": 0,
        "abbreviateValue": false,
        "animate": true,
        "bgOpacity": 18,
        "backgroundColor": "transparent"
      }
    },
    "kpi_savings": {
      "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
      "dataSources": {
        "primary": "ds_kpi_savings"
      },
      "options": {
        "labelField": "> primary | seriesByName('月')",
        "valueField": "> primary | seriesByName('億円')",
        "titleText": "被害回避額の累計（億円）",
        "deltaLabel": "前月比",
        "accentColor": "#9b7cf0",
        "iconName": "star",
        "showIcon": true,
        "showGlow": true,
        "showDelta": true,
        "deltaAsPercent": false,
        "deltaColorMode": "positiveGood",
        "sparkMode": "bars",
        "valueDecimals": 1,
        "abbreviateValue": false,
        "animate": true,
        "bgOpacity": 18,
        "backgroundColor": "transparent"
      }
    },
    "viz_globe": {
      "type": "custom_viz_attack_globe.custom_viz_attack_globe",
      "title": "グローバル脅威の到達状況（拠点別）",
      "dataSources": {
        "primary": "ds_globe"
      },
      "options": {
        "srcLatField": "> primary | seriesByName('src_lat')",
        "srcLonField": "> primary | seriesByName('src_lon')",
        "dstLatField": "> primary | seriesByName('dst_lat')",
        "dstLonField": "> primary | seriesByName('dst_lon')",
        "categoryField": "> primary | seriesByName('category')",
        "countField": "> primary | seriesByName('count')",
        "srcNameField": "> primary | seriesByName('src_name')",
        "dstNameField": "> primary | seriesByName('dst_name')",
        "titleText": "GLOBAL THREAT REACH",
        "showLegend": true,
        "showPointNames": false,
        "flowPeriod": 3.4,
        "rotatePeriod": 120,
        "widthScale": 1,
        "shadeMode": "daynight",
        "showGraticule": true,
        "showBorders": true,
        "atmosphere": 1.25,
        "textureSize": "2048",
        "centerLon": 120,
        "centerLat": 22,
        "initialZoom": 1,
        "interactive": true,
        "colorMode": "category",
        "categoryColors": [
          "標的型攻撃|#e8604c",
          "ランサムウェア|#9b7cf0",
          "情報窃取|#d8b46a",
          "偵察・スキャン|#5b8def"
        ],
        "fallbackColor": "#7c8aa5",
        "transparentBg": true,
        "backgroundColor": "transparent"
      }
    },
    "viz_risk_gauge": {
      "type": "custom_viz_gauge_arc.custom_viz_gauge_arc",
      "title": "全社リスク指数（低いほど良い）",
      "dataSources": {
        "primary": "ds_risk_index"
      },
      "options": {
        "valueField": "> primary | seriesByName('リスク指数')",
        "labelField": "> primary | seriesByName('月')",
        "aggMode": "last",
        "minValue": 0,
        "maxValue": 100,
        "gaugeStyle": "segmented",
        "sweepAngle": 240,
        "arcThickness": 18,
        "segmentCount": 32,
        "segmentGap": 30,
        "litMode": "band",
        "showTrack": true,
        "showGlow": true,
        "glowStrength": 50,
        "showTicks": true,
        "showRangeLabels": true,
        "showBoundaryValues": true,
        "animate": true,
        "colorMode": "band",
        "colorBands": [
          {
            "from": null,
            "to": 40,
            "value": "#3fbf7f"
          },
          {
            "from": 40,
            "to": 70,
            "value": "#e0a63c"
          },
          {
            "from": 70,
            "to": null,
            "value": "#e8604c"
          }
        ],
        "titleText": "RISK INDEX",
        "unitText": "pt",
        "decimals": 0,
        "showTitle": true,
        "valueColorMode": "band",
        "compareMode": "first",
        "deltaLabel": "年度初比",
        "goodDirection": "down",
        "upColor": "#e8604c",
        "downColor": "#3fbf7f",
        "showDelta": true,
        "panelPosition": "right",
        "panelWidth": 0.42,
        "slot1": "delta",
        "slot2": "sparkline",
        "slot3": "stats",
        "slot4": "none",
        "statList": [
          "max",
          "min",
          "avg"
        ],
        "targetValue": 25,
        "showTarget": false,
        "backgroundColor": "transparent"
      }
    },
    "viz_incident_mix": {
      "type": "custom_viz_donut_graph.custom_viz_donut_graph",
      "title": "インシデント種別の構成（当四半期）",
      "dataSources": {
        "primary": "ds_incident_mix"
      },
      "options": {
        "categoryField": "> primary | seriesByName('種別')",
        "valueField": "> primary | seriesByName('件数')",
        "seriesColors": [
          "#e8604c",
          "#e0a63c",
          "#d8b46a",
          "#9b7cf0",
          "#5b8def",
          "#2fc2ac"
        ],
        "thickness": 26,
        "gap": 3,
        "maxSegments": 6,
        "showLegend": true,
        "showTotal": true,
        "showPercent": true,
        "showBar": true,
        "rounded": true,
        "glow": true,
        "glowStrength": 6,
        "backgroundColor": "transparent"
      }
    },
    "viz_kpi_bullet": {
      "type": "custom_viz_bullet_graph.custom_viz_bullet_graph",
      "title": "経営目標に対する達成状況",
      "dataSources": {
        "primary": "ds_kpi_targets"
      },
      "options": {
        "labelField": "> primary | seriesByName('指標')",
        "valueField": "> primary | seriesByName('実績')",
        "targetField": "> primary | seriesByName('目標')",
        "showBands": true,
        "band1Pct": 60,
        "band2Pct": 85,
        "showTarget": true,
        "showCompare": false,
        "showValues": true,
        "showPercent": true,
        "sharedScale": false,
        "sortByAchievement": false,
        "animate": true,
        "useValueColors": true,
        "goodColor": "#3fbf7f",
        "warnColor": "#e0a63c",
        "badColor": "#e8604c",
        "valueDecimals": 0,
        "abbreviateValue": false,
        "backgroundColor": "transparent"
      }
    },
    "viz_board_report": {
      "type": "custom_viz_severity_table.custom_viz_severity_table",
      "title": "取締役会への報告事項",
