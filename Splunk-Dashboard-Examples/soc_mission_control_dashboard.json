{
    "title": "SOC ミッションコントロール",
    "description": "壁掛けモニタ向けの SOC 統合ビュー。Attack Globe（回転する3D地球儀）を主役に、Liquid Tube / Icon Status / Gauge Arc / Spotlight Frame などのカスタムビジュアライゼーションで構成。全パネルが makeresults のサンプルデータで動作するため、実データ無しでそのまま表示を確認できる。",
    "inputs": {
        "input_time": {
            "type": "input.timerange",
            "title": "時間範囲",
            "options": {
                "token": "global_time",
                "defaultValue": "-24h@h,now"
            }
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "latest": "now"
                    }
                }
            }
        },
        "visualizations": {
            "global": {
                "showLastUpdated": false,
                "showProgressBar": false
            }
        }
    },
    "visualizations": {
        "viz_tabs": {
            "type": "custom_viz_tab_selector.custom_viz_tab_selector",
            "title": "対象リージョン",
            "description": "クリックでトークン region を切り替える。トークンの反映には編集画面「インタラクション」で「トークンを設定」を1回だけ設定する必要がある。",
            "options": {
                "tabs": [
                    "全リージョン|*",
                    "東京|apac-tokyo",
                    "大阪|apac-osaka",
                    "シンガポール|apac-sg",
                    "フランクフルト|emea-fra"
                ],
                "defaultTabIndex": 1,
                "tabStyle": "pill",
                "align": "left",
                "fontSize": 14,
                "accentColor": "#38bdf8",
                "backgroundColor": "transparent"
            }
        },
        "viz_status_frame": {
            "type": "custom_viz_spotlight_frame.custom_viz_spotlight_frame",
            "title": "全体ステータス",
            "description": "Critical 件数で OK / WARNING / CRITICAL を判定し、枠の色・発光・点滅で全体状態を示す。",
            "dataSources": {
                "primary": "ds_status"
            },
            "options": {
                "labelField": "> primary | seriesByName('service')",
                "valueField": "> primary | seriesByName('critical')",
                "titleText": "SOC OVERALL STATUS",
                "showTitle": true,
                "showBadge": true,
                "showCounts": true,
                "matchMode": "numeric",
                "colorBands": [
                    {
                        "from": null,
                        "to": 1,
                        "value": "#22c55e"
                    },
                    {
                        "from": 1,
                        "to": 5,
                        "value": "#f59e0b"
                    },
                    {
                        "from": 5,
                        "to": null,
                        "value": "#ef4444"
                    }
                ],
                "borderWidth": 4,
                "cornerRadius": 12,
                "showGlow": true,
                "glowStrength": 60,
                "pulseMode": "crit",
                "fillOpacity": 8,
                "backgroundColor": "transparent"
            }
        },
        "viz_kpi_events": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "title": "総イベント数",
            "dataSources": {
                "primary": "ds_kpi_events"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "TOTAL EVENTS / 24H",
                "deltaLabel": "前日比",
                "accentColor": "#38bdf8",
                "iconName": "pulse",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaAsPercent": true,
                "deltaColorMode": "positiveBad",
                "sparkMode": "line",
                "abbreviateValue": true,
                "bgOpacity": 20,
                "backgroundColor": "transparent"
            }
        },
        "viz_kpi_blocked": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "title": "ブロック数",
            "dataSources": {
                "primary": "ds_kpi_blocked"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "BLOCKED / 24H",
                "deltaLabel": "前日比",
                "accentColor": "#22c55e",
                "iconName": "shield",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaAsPercent": true,
                "deltaColorMode": "positiveGood",
                "sparkMode": "bars",
                "abbreviateValue": true,
                "bgOpacity": 20,
                "backgroundColor": "transparent"
            }
        },
        "viz_icon_fw": {
            "type": "custom_viz_icon_status.custom_viz_icon_status",
            "title": "ファイアウォール",
            "description": "アイコンの立体的な陰影・差し色・発光までがしきい値に連動して一斉に色を変える。",
            "dataSources": {
                "primary": "ds_health_fw"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('load')",
                "iconName": "firewall",
                "iconStyle": "solid",
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3fb950"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#d29922"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#f85149"
                    }
                ],
                "labelText": "FIREWALL",
                "unitText": "%",
                "aggregation": "last",
                "showGlow": true,
                "showShadow": true,
                "pulseMode": "ring",
                "showCard": false,
                "backgroundColor": "transparent"
            }
        },
        "viz_icon_edr": {
            "type": "custom_viz_icon_status.custom_viz_icon_status",
            "title": "エンドポイント",
            "dataSources": {
                "primary": "ds_health_edr"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('load')",
                "iconName": "endpoint",
                "iconStyle": "solid",
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3fb950"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#d29922"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#f85149"
                    }
                ],
                "labelText": "ENDPOINT",
                "unitText": "%",
                "aggregation": "last",
                "showGlow": true,
                "showShadow": true,
                "pulseMode": "ring",
                "showCard": false,
                "backgroundColor": "transparent"
            }
        },
        "viz_globe": {
            "type": "custom_viz_attack_globe.custom_viz_attack_globe",
            "title": "グローバル攻撃状況",
            "description": "WebGL でレイトレースした3D地球儀。ドラッグで回転、ホイールでズーム、放置すると自転する。WebGL2 が必要。",
            "dataSources": {
                "primary": "ds_attacks"
            },
            "options": {
                "srcLatField": "> primary | seriesByName('src_lat')",
                "srcLonField": "> primary | seriesByName('src_lon')",
                "dstLatField": "> primary | seriesByName('dst_lat')",
                "dstLonField": "> primary | seriesByName('dst_lon')",
                "categoryField": "> primary | seriesByName('category')",
                "countField": "> primary | seriesByName('count')",
                "srcNameField": "> primary | seriesByName('src_name')",
                "dstNameField": "> primary | seriesByName('dst_name')",
                "titleText": "GLOBAL ATTACK GLOBE",
                "showLegend": true,
                "showPointNames": false,
                "flowPeriod": 3,
                "rotatePeriod": 90,
                "widthScale": 1,
                "shadeMode": "daynight",
                "showGraticule": true,
                "showBorders": true,
                "atmosphere": 1.2,
                "textureSize": "2048",
                "centerLon": 135,
                "centerLat": 20,
                "initialZoom": 1,
                "interactive": true,
                "colorMode": "category",
                "categoryColors": [
                    "exploit|#ff5a2e",
                    "malware|#a06cff",
                    "scan|#38a6ff",
                    "bruteforce|#e6b93c"
                ],
                "fallbackColor": "#94a3b8",
                "transparentBg": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_timeline": {
            "type": "custom_viz_timeline_swimlane.custom_viz_timeline_swimlane",
            "title": "インシデント・タイムライン",
            "description": "ホストごとのレーンにイベントを時刻順で配置。横ドラッグで時間範囲を絞り込める。",
            "dataSources": {
                "primary": "ds_timeline"
            },
            "options": {
                "laneField": "> primary | seriesByName('host')",
                "startField": "> primary | seriesByName('start')",
                "endField": "> primary | seriesByName('end')",
                "categoryField": "> primary | seriesByName('phase')",
                "labelField": "> primary | seriesByName('detail')",
                "sortLanes": "count",
                "autoLaneHeight": true,
                "showLaneLabels": true,
                "showLaneCount": true,
                "showAxis": true,
                "showGrid": true,
                "showLegend": true,
                "showCrosshair": true,
                "enableBrush": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_horizon": {
            "type": "custom_viz_horizon_chart.custom_viz_horizon_chart",
            "title": "ホスト別 CPU 使用率",
            "description": "多数の時系列を色帯に畳んで、どのホストが同時に跳ねたかを一望する。",
            "dataSources": {
                "primary": "ds_horizon"
            },
            "options": {
                "timeField": "> primary | seriesByName('_time')",
                "seriesField": "> primary | seriesByName('host')",
                "valueField": "> primary | seriesByName('cpu')",
                "bands": 3,
                "perSeriesScale": false,
                "showNegative": false,
                "positiveColor": "#38bdf8",
                "laneHeight": 30,
                "autoFitLanes": true,
                "curve": true,
                "sortMode": "peak",
                "showLabels": true,
                "showPeakValue": true,
                "showTimeAxis": true,
                "showLegend": false,
                "showCrosshair": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_gauge": {
            "type": "custom_viz_gauge_arc.custom_viz_gauge_arc",
            "title": "SLA 達成率",
            "dataSources": {
                "primary": "ds_sla"
            },
            "options": {
                "valueField": "> primary | seriesByName('sla')",
                "labelField": "> primary | seriesByName('_time')",
                "aggMode": "last",
                "minValue": 90,
                "maxValue": 100,
                "gaugeStyle": "tachometer",
                "sweepAngle": 240,
                "arcThickness": 18,
                "litMode": "band",
                "showTrack": true,
                "showGlow": true,
                "showTicks": true,
                "showRangeLabels": true,
                "showBoundaryValues": true,
                "showNeedle": true,
                "animate": true,
                "colorMode": "band",
                "colorBands": [
                    {
                        "from": null,
                        "to": 97,
                        "value": "#ef4444"
                    },
                    {
                        "from": 97,
                        "to": 99,
                        "value": "#f59e0b"
                    },
                    {
                        "from": 99,
                        "to": null,
                        "value": "#22c55e"
                    }
                ],
                "titleText": "SLA",
                "unitText": "%",
                "decimals": 2,
                "showTitle": true,
                "compareMode": "prev",
                "deltaLabel": "前時間比",
                "goodDirection": "up",
                "showDelta": true,
                "panelPosition": "right",
                "panelWidth": 0.4,
                "slot1": "delta",
                "slot2": "sparkline",
                "slot3": "stats",
                "slot4": "none",
                "statList": [
                    "max",
                    "min",
                    "avg"
                ],
                "backgroundColor": "transparent"
            }
        },
        "viz_tube_cpu": {
            "type": "custom_viz_liquid_tube.custom_viz_liquid_tube",
            "title": "CPU",
            "description": "WebGL シェーダで屈折・透過・気泡を描く試験管ゲージ。WebGL2 が必要。",
            "dataSources": {
                "primary": "ds_res_cpu"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "minValue": 0,
                "maxValue": 100,
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3ddc84"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#e6b93c"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#ff5a2e"
                    }
                ],
                "transparentBg": true,
                "liquidOpacity": 0.5,
                "bubbleCount": 20,
                "animSpeed": 1,
                "showLabel": true,
                "showValue": true,
                "valueUnit": "%",
                "aggregation": "last",
                "glow": 1,
                "tubeWidth": 0.17,
                "backgroundColor": "transparent"
            }
        },
        "viz_tube_mem": {
            "type": "custom_viz_liquid_tube.custom_viz_liquid_tube",
            "title": "メモリ",
            "dataSources": {
                "primary": "ds_res_mem"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "minValue": 0,
                "maxValue": 100,
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3ddc84"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#e6b93c"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#ff5a2e"
                    }
                ],
                "transparentBg": true,
                "liquidOpacity": 0.5,
                "bubbleCount": 20,
                "animSpeed": 1,
                "showLabel": true,
                "showValue": true,
                "valueUnit": "%",
                "aggregation": "last",
                "glow": 1,
                "tubeWidth": 0.17,
                "backgroundColor": "transparent"
            }
        },
        "viz_tube_disk": {
            "type": "custom_viz_liquid_tube.custom_viz_liquid_tube",
            "title": "ディスク",
            "dataSources": {
                "primary": "ds_res_disk"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "minValue": 0,
                "maxValue": 100,
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3ddc84"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#e6b93c"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#ff5a2e"
                    }
                ],
                "transparentBg": true,
                "liquidOpacity": 0.5,
                "bubbleCount": 20,
                "animSpeed": 1,
                "showLabel": true,
                "showValue": true,
                "valueUnit": "%",
                "aggregation": "last",
                "glow": 1,
                "tubeWidth": 0.17,
                "backgroundColor": "transparent"
            }
        },
        "viz_funnel": {
            "type": "custom_viz_funnel_leak.custom_viz_funnel_leak",
            "title": "攻撃チェーンの生存分析",
            "description": "各段の通過を下へ流し、遮断できた分を左右にこぼれ落ちる粒子で表す。",
            "dataSources": {
                "primary": "ds_funnel"
            },
            "options": {
                "stepField": "> primary | seriesByName('step')",
                "valueField": "> primary | seriesByName('count')",
                "flowColor": "#38bdf8",
                "leakColor": "#ef4d4d",
                "animationPeriod": 6,
                "particleDensity": 55,
                "barThickness": 40,
                "stepGap": 46,
                "showStepLabels": true,
                "showCounts": true,
                "showRate": true,
                "showLeak": true,
                "showOverallRate": true,
                "showHeader": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_sunburst": {
            "type": "custom_viz_sunburst.custom_viz_sunburst",
            "title": "検知ソースの内訳",
            "description": "中心が根、外側ほど下の階層。クリックで掘り下げ、中央 KPI クリックで1つ戻る。",
            "dataSources": {
                "primary": "ds_sunburst"
            },
            "options": {
                "valueField": "> primary | seriesByName('count')",
                "level1Field": "> primary | seriesByName('source')",
                "level2Field": "> primary | seriesByName('category')",
                "level3Field": "> primary | seriesByName('rule')",
                "maxDepth": 3,
                "innerRadiusPercent": 24,
                "showLabels": true,
                "showCenter": true,
                "centerTitle": "検知数",
                "showBreadcrumb": true,
                "enableDrilldown": true,
                "dimOthers": true,
                "animate": true,
                "abbreviateValue": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_heatmatrix": {
            "type": "custom_viz_heat_matrix.custom_viz_heat_matrix",
            "title": "曜日×時間帯の検知密度",
            "dataSources": {
                "primary": "ds_heatmatrix"
            },
            "options": {
                "rowField": "> primary | seriesByName('weekday')",
                "colField": "> primary | seriesByName('hour')",
                "valueField": "> primary | seriesByName('count')",
                "lowColor": "#0d2137",
                "midColor": "#2f7fd0",
                "highColor": "#ff5a2e",
                "useMidColor": true,
                "showValues": false,
                "showXLabels": true,
                "showYLabels": true,
                "showLegend": true,
                "cellGap": 2,
                "cellRadius": 2,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_bullet": {
            "type": "custom_viz_bullet_graph.custom_viz_bullet_graph",
            "title": "SOC KPI 対 目標",
            "description": "実績バー＋目標ティック＋良／可／不可のバンドを1行に重ねて、多数の指標を目標比つきで一覧する。",
            "dataSources": {
                "primary": "ds_bullet"
            },
            "options": {
                "labelField": "> primary | seriesByName('metric')",
                "valueField": "> primary | seriesByName('actual')",
                "targetField": "> primary | seriesByName('target')",
                "showBands": true,
                "band1Pct": 60,
                "band2Pct": 85,
                "showTarget": true,
                "showValues": true,
                "showPercent": true,
                "useValueColors": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_severity": {
            "type": "custom_viz_severity_table.custom_viz_severity_table",
            "title": "アクティブアラート",
            "dataSources": {
                "primary": "ds_alerts"
            },
            "options": {
                "severityField": "> primary | seriesByName('severity')",
                "sortMode": "desc",
                "maxRows": 12,
                "severityMode": "string",
                "cellStyle": "pill",
                "rowBar": true,
                "zebra": true,
                "compact": true,
                "showSummary": true,
                "title": "",
                "backgroundColor": "transparent"
            }
        },
        "viz_treemap": {
            "type": "custom_viz_treemap.custom_viz_treemap",
            "title": "ログ量の内訳",
            "description": "面積で容量を表す。どこがストレージを食っているかが一目で分かる。",
            "dataSources": {
                "primary": "ds_treemap"
            },
            "options": {
                "valueField": "> primary | seriesByName('bytes')",
                "level1Field": "> primary | seriesByName('index')",
                "level2Field": "> primary | seriesByName('sourcetype')",
                "maxDepth": 2,
                "shadeChildren": true,
                "showLabels": true,
                "showValues": true,
                "showPercent": true,
                "showGroupHeaders": true,
                "showBreadcrumb": true,
                "enableDrilldown": true,
                "animate": true,
                "abbreviateValue": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_waterfall": {
            "type": "custom_viz_waterfall_chart.custom_viz_waterfall_chart",
            "title": "アラート増減の内訳",
            "description": "前週からの増減が今週の総数に至る過程を階段状バーで示す。",
            "dataSources": {
                "primary": "ds_waterfall"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('delta')",
                "typeField": "> primary | seriesByName('kind')",
                "showTotal": true,
                "totalLabel": "今週合計",
                "increaseColor": "#f85149",
                "decreaseColor": "#3fb950",
                "totalColor": "#4f8ff7",
                "showValues": true,
                "showConnectors": true,
                "showAxis": true,
                "showXLabels": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_radial": {
            "type": "custom_viz_radial_bar.custom_viz_radial_bar",
            "title": "攻撃元 国別ランキング",
            "dataSources": {
                "primary": "ds_radial"
            },
            "options": {
                "categoryField": "> primary | seriesByName('country')",
                "valueField": "> primary | seriesByName('count')",
                "centerTitle": "総攻撃数",
                "useValueColors": true,
                "lowColor": "#38bdf8",
                "midColor": "#7c3aed",
                "highColor": "#ff5a2e",
                "useMidColor": true,
                "maxBars": 10,
                "innerRadiusPct": 34,
                "showTrack": true,
                "showLabels": true,
                "showTotal": true,
                "glow": true,
                "valueFormat": "comma",
                "backgroundColor": "transparent"
            }
        }
    },
    "dataSources": {
        "ds_status": {
            "type": "ds.search",
            "name": "ds_status",
            "options": {
                "query": "| makeresults format=csv data=\"service,critical\nSOC Platform,3\"",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_kpi_events": {
            "type": "ds.search",
            "name": "ds_kpi_events",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n18:00,412000\n19:00,438000\n20:00,455000\n21:00,491000\n22:00,528000\n23:00,502000\n00:00,487000\n01:00,516000\"",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_kpi_blocked": {
            "type": "ds.search",
            "name": "ds_kpi_blocked",
            "options": {
