{
    "title": "ネットワーク機器 構成監視",
    "description": "サーバ／ネットワーク機器を Icon Status のアイコンで表し、機器と機器の間を Link Line のコネクタ線で結んだ構成監視ビュー。アイコンは負荷のしきい値で色が変わり、線は回線使用率（範囲）と死活（文字列一致）で色が変わる。全パネルが makeresults のサンプルデータで動作するため、実データ無しでそのまま表示を確認できる。",
    "inputs": {
        "input_time": {
            "type": "input.timerange",
            "title": "時間範囲",
            "options": {
                "token": "global_time",
                "defaultValue": "-60m@m,now"
            }
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "latest": "now"
                    }
                }
            }
        },
        "visualizations": {
            "global": {
                "showLastUpdated": false,
                "showProgressBar": false
            }
        }
    },
    "visualizations": {
        "viz_site_tabs": {
            "type": "custom_viz_tab_selector.custom_viz_tab_selector",
            "title": "対象サイト",
            "description": "クリックでトークン site を切り替える。トークンの反映には編集画面「インタラクション」で「トークンを設定」を1回だけ設定する必要がある。",
            "options": {
                "tabs": [
                    "東京DC|tokyo",
                    "大阪DC|osaka",
                    "全サイト|*"
                ],
                "defaultTabIndex": 1,
                "tabStyle": "pill",
                "align": "left",
                "fontSize": 14,
                "accentColor": "#5b8def",
                "backgroundColor": "transparent"
            }
        },
        "viz_net_frame": {
            "type": "custom_viz_spotlight_frame.custom_viz_spotlight_frame",
            "title": "ネットワーク総合ステータス",
            "description": "ダウン中の機器数で判定し、枠の色・発光・点滅で全体状態を示す。",
            "dataSources": {
                "primary": "ds_net_status"
            },
            "options": {
                "labelField": "> primary | seriesByName('scope')",
                "valueField": "> primary | seriesByName('down')",
                "titleText": "NETWORK STATUS",
                "showTitle": true,
                "showBadge": true,
                "showCounts": true,
                "matchMode": "numeric",
                "colorBands": [
                    {
                        "from": null,
                        "to": 1,
                        "value": "#22c55e"
                    },
                    {
                        "from": 1,
                        "to": 2,
                        "value": "#f59e0b"
                    },
                    {
                        "from": 2,
                        "to": null,
                        "value": "#ef4444"
                    }
                ],
                "okLabel": "正常",
                "warnLabel": "縮退",
                "critLabel": "障害",
                "borderWidth": 4,
                "cornerRadius": 12,
                "showGlow": true,
                "glowStrength": 55,
                "pulseMode": "crit",
                "fillOpacity": 8,
                "backgroundColor": "transparent"
            }
        },
        "viz_node_fw": {
            "type": "custom_viz_icon_status.custom_viz_icon_status",
            "title": "境界ファイアウォール",
            "description": "アイコンの陰影・差し色・発光が CPU 使用率のしきい値に連動して一斉に色を変える。",
            "dataSources": {
                "primary": "ds_node_fw"
            },
            "options": {
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('load')",
                "iconName": "firewall",
                "iconStyle": "solid",
                "colorMode": "threshold",
                "colorBands": [
                    {
                        "from": null,
                        "to": 60,
                        "value": "#3fb950"
                    },
                    {
                        "from": 60,
                        "to": 85,
                        "value": "#d29922"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#f85149"
                    }
                ],
                "labelText": "FW-01",
                "unitText": "%",
                "aggregation": "last",
                "showGlow": true,
                "showShadow": true,
                "pulseMode": "none",
                "showCard": false,
                "iconScale": 1,
                "backgroundColor": "transparent"
            }
        },
        "viz_node_core": {
            "type": "custom_viz_icon_status.custom_viz_icon_status",
