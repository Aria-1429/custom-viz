                "primary": "ds_device_capacity"
            },
            "options": {
                "labelField": "> primary | seriesByName('device')",
                "valueField": "> primary | seriesByName('used')",
                "targetField": "> primary | seriesByName('limit')",
                "showBands": true,
                "band1Pct": 60,
                "band2Pct": 85,
                "showTarget": true,
                "showValues": true,
                "showPercent": true,
                "useValueColors": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_alert_table": {
            "type": "custom_viz_severity_table.custom_viz_severity_table",
            "title": "機器アラート",
            "dataSources": {
                "primary": "ds_device_alerts"
            },
            "options": {
                "severityField": "> primary | seriesByName('severity')",
                "sortMode": "desc",
                "maxRows": 10,
                "severityMode": "string",
                "cellStyle": "pill",
                "rowBar": true,
                "zebra": true,
                "compact": true,
                "showSummary": true,
                "title": "",
                "backgroundColor": "transparent"
            }
        }
    },
