        "viz_port_matrix": {
            "type": "custom_viz_heat_matrix.custom_viz_heat_matrix",
            "title": "スイッチ × ポート 使用率",
            "dataSources": {
                "primary": "ds_port_matrix"
            },
            "options": {
                "rowField": "> primary | seriesByName('switch')",
                "colField": "> primary | seriesByName('port')",
                "valueField": "> primary | seriesByName('usage')",
                "lowColor": "#0d2137",
                "midColor": "#f5c518",
                "highColor": "#ef4d4d",
                "useMidColor": true,
                "showValues": false,
                "showXLabels": true,
                "showYLabels": true,
                "showLegend": true,
                "cellGap": 2,
                "cellRadius": 2,
                "animate": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_device_bullet": {
            "type": "custom_viz_bullet_graph.custom_viz_bullet_graph",
            "title": "機器リソース 対 上限",
