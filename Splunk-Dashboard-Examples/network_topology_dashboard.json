        "viz_iface_horizon": {
            "type": "custom_viz_horizon_chart.custom_viz_horizon_chart",
            "title": "インタフェース別トラフィック",
            "dataSources": {
                "primary": "ds_iface"
            },
            "options": {
                "timeField": "> primary | seriesByName('_time')",
                "seriesField": "> primary | seriesByName('iface')",
                "valueField": "> primary | seriesByName('mbps')",
                "bands": 3,
                "perSeriesScale": false,
                "showNegative": false,
                "positiveColor": "#5b8def",
                "laneHeight": 30,
                "autoFitLanes": true,
                "curve": true,
                "sortMode": "peak",
                "showLabels": true,
                "showPeakValue": true,
                "showTimeAxis": true,
                "showLegend": false,
                "showCrosshair": true,
                "animate": true,
                "backgroundColor": "transparent"
            }
