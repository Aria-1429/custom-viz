            "name": "ds_iface",
            "options": {
                "query": "| makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, iface=\"Gi0/1 (uplink)\", mbps=780+240*sin(i/4)+random()%130 | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, iface=\"Gi0/2 (web)\", mbps=520+180*sin(i/5+1)+random()%110 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, iface=\"Gi0/3 (app)\", mbps=430+160*sin(i/3+2)+random()%95 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, iface=\"Gi0/4 (db)\", mbps=290+120*sin(i/6)+random()%80 ] | append [ | makeresults count=48 | streamstats count as i | eval _time=relative_time(now(), \"-48m\") + i*60, iface=\"Te1/1 (cloud)\", mbps=210+90*sin(i/4+3)+random()%70 ] | table _time iface mbps",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_port_matrix": {
            "type": "ds.search",
            "name": "ds_port_matrix",
            "options": {
                "query": "| makeresults count=96 | streamstats count as i | eval sw=floor((i-1)/24)+1, pnum=((i-1)%24)+1 | eval switch=\"SW-0\" . tostring(sw) | eval port=if(pnum<10, \"P0\" . tostring(pnum), \"P\" . tostring(pnum)) | eval usage=case(pnum<=4, 55+random()%40, pnum<=12, 25+random()%35, true(), random()%22) | table switch port usage",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_device_capacity": {
            "type": "ds.search",
            "name": "ds_device_capacity",
            "options": {
                "query": "| makeresults format=csv data=\"device,used,limit\nFW-01 セッション数,182000,200000\nCORE-SW MACテーブル,14200,16384\nLB-01 同時接続,38400,50000\nAPP-01 ヒープ(MB),7400,8192\nDB-01 コネクション,412,500\nCLOUD-GW 帯域(Mbps),340,500\"",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        },
        "ds_device_alerts": {
            "type": "ds.search",
            "name": "ds_device_alerts",
            "options": {
                "query": "| makeresults format=csv data=\"検知時刻,severity,機器,事象,担当\n02:14,critical,DB-01,コネクション枯渇の兆候,佐藤\n01:52,critical,APP-02,ヒープ使用率 92%,田中\n01:35,high,WEB-03,応答時間の劣化,鈴木\n01:08,high,CORE-SW,MACテーブル使用率 87%,山田\n00:46,medium,FW-01,セッション数の増加,佐藤\n00:23,medium,LB-02,ヘルスチェック失敗 2回,田中\n23:58,medium,CLOUD-GW,専用線のジッタ増加,鈴木\n23:31,low,SW-03,ポート P18 リンクフラップ,山田\n23:05,low,WEB-04,証明書の期限まで30日,佐藤\n22:40,low,CACHE-01,ヒット率の低下,田中\"",
                "queryParameters": {
                    "earliest": "$global_time.earliest$",
                    "latest": "$global_time.latest$"
                }
            }
        }
    },
