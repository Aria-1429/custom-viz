        "viz_link_fw_core": {
            "type": "custom_viz_link_line.custom_viz_link_line",
            "title": "FW → コアSW",
            "description": "回線使用率（%）で色が変わる。線の形は表示画面の「✎ 線を編集」でも調整できる。",
            "dataSources": {
                "primary": "ds_link_fw_core"
            },
            "options": {
                "valueField": "> primary | seriesByName('usage')",
                "linePoints": "[[0.04,0.5],[0.96,0.5]]",
                "styleMode": "pipe",
                "lineWidth": 9,
                "lineGradient": true,
                "flowSpeed": 2,
                "flowDirection": "forward",
                "pulseCaps": true,
                "showEndCaps": true,
                "arrowHead": true,
                "showValue": true,
                "valueDecimals": 0,
                "unitLabel": "%",
                "linkLabel": "10G アップリンク",
                "colorMode": "range",
                "colorBands": [
                    {
                        "from": 0,
                        "to": 40,
                        "value": "#53a051"
                    },
                    {
                        "from": 40,
                        "to": 70,
                        "value": "#f8be34"
                    },
                    {
                        "from": 70,
                        "to": 90,
                        "value": "#f1813f"
                    },
                    {
                        "from": 90,
                        "to": null,
                        "value": "#dc4e41"
                    }
                ],
                "lineOpacity": 100,
                "allowViewEdit": true,
                "backgroundColor": "transparent"
            }
        },
        "viz_link_core_web": {
            "type": "custom_viz_link_line.custom_viz_link_line",
