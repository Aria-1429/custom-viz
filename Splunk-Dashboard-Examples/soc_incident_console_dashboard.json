{
    "title": "SOC インシデント調査コンソール",
    "description": "アラートキューの行をクリックすると、右の調査ペインと下の関連イベントがそのホストに切り替わります（Severity Table のインタラクション）",
    "inputs": {
        "input_time": {
            "type": "input.timerange",
            "title": "時間範囲",
            "options": {
                "token": "global_time",
                "defaultValue": "-24h@h,now"
            }
        },
        "input_host": {
            "type": "input.dropdown",
            "title": "調査対象ホスト",
            "options": {
                "token": "sel_host",
                "defaultValue": "web-01",
                "items": [
                    {
                        "label": "file-04",
                        "value": "file-04"
                    },
                    {
                        "label": "db-03",
                        "value": "db-03"
                    },
                    {
                        "label": "web-01",
                        "value": "web-01"
                    },
                    {
                        "label": "vpn-01",
                        "value": "vpn-01"
                    },
                    {
                        "label": "app-02",
                        "value": "app-02"
                    },
                    {
                        "label": "proxy-02",
                        "value": "proxy-02"
                    },
                    {
                        "label": "mail-01",
                        "value": "mail-01"
                    },
                    {
                        "label": "dns-01",
                        "value": "dns-01"
                    }
                ]
            }
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "latest": "now"
                    }
                }
            }
        },
        "visualizations": {
            "global": {
                "showLastUpdated": false,
                "showProgressBar": false
            }
        }
    },
    "dataSources": {
        "ds_alerts": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"time,severity,rule,host,src\n10:12,critical,ランサム挙動の検知,file-04,10.4.8.30\n10:09,critical,大量データの外部転送,db-03,10.4.2.19\n09:58,high,Web シェルの配置,web-01,203.0.113.44\n09:52,high,認証情報の窃取,vpn-01,198.51.100.7\n09:47,high,SMB 経由の横展開,app-02,10.4.9.11\n09:41,medium,SQLi 試行の遮断,web-01,203.0.113.90\n09:35,medium,不審な外部通信,proxy-02,45.83.66.12\n09:28,medium,権限昇格の試行,app-02,10.4.1.2\n09:20,low,ポートスキャン,web-01,45.83.66.12\n09:11,low,フィッシングの隔離,mail-01,185.220.101.5\n09:02,low,DNS クエリの急増,dns-01,10.4.3.7\n08:55,info,設定のリロード,proxy-02,10.4.0.9\" | table time severity rule host src"
            },
            "name": "アラートキュー"
        },
        "ds_risk": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults count=12 | streamstats count as i | eval _time=relative_time(now(), \"-2h\") + i*600 | eval host=\"$sel_host$\" | eval base=case(host==\"file-04\",96,host==\"db-03\",92,host==\"web-01\",88,host==\"vpn-01\",81,host==\"app-02\",74,host==\"proxy-02\",55,host==\"mail-01\",41,host==\"dns-01\",33,1==1,50) | eval score=round(base-(12-i)*1.6+(i%3)*2,0) | table _time host score"
            },
            "name": "選択ホストのリスクスコア推移"
        },
        "ds_radar": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"domain,factor\nIdentity,0.86\nEndpoint,1.08\nNetwork,0.94\nCloud,0.72\nData,1.15\" | eval host=\"$sel_host$\" | eval base=case(host==\"file-04\",96,host==\"db-03\",92,host==\"web-01\",88,host==\"vpn-01\",81,host==\"app-02\",74,host==\"proxy-02\",55,host==\"mail-01\",41,host==\"dns-01\",33,1==1,50) | eval cur=round(base*factor,0), bench=round(58*factor,0) | rename domain as ドメイン, cur as 選択ホスト, bench as 全社平均 | table ドメイン 選択ホスト 全社平均"
            },
            "name": "選択ホストのリスク内訳"
        },
        "ds_host_events": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"host,time,severity,event,detail\nfile-04,10:12,critical,ファイル暗号化の兆候,拡張子 .lock への一括改名 1842 件\nfile-04,10:04,high,シャドウコピーの削除,vssadmin delete shadows /all\nfile-04,09:56,medium,不審なプロセス起動,powershell -enc（難読化）\ndb-03,10:09,critical,大量データの外部転送,4.2GB / 8分 → 203.0.113.201\ndb-03,10:01,high,異常な件数のクエリ,SELECT 全件 × 37 回\ndb-03,09:44,medium,新規管理者アカウント,svc_backup2 を作成\nweb-01,09:58,high,Web シェルの配置,/var/www/upload/x.php\nweb-01,09:41,medium,SQLi 試行の遮断,WAF が 214 件をブロック\nweb-01,09:20,low,ポートスキャン,22/80/443/3389 を順次\nweb-01,09:05,info,証明書の更新,有効期限 +90日\nvpn-01,09:52,high,認証情報の窃取,LSASS へのアクセス試行\nvpn-01,09:35,medium,地理的にありえないログイン,東京 → サンパウロ 11分\nvpn-01,09:12,low,総当たりログイン,失敗 318 回 / 成功 1 回\napp-02,09:47,high,SMB 経由の横展開,web-01 → app-02 → db-03\napp-02,09:28,medium,権限昇格の試行,トークン複製を検知\napp-02,09:03,low,サービスの新規登録,自動起動に設定\nproxy-02,09:35,medium,不審な外部通信,C2 ビーコン様の周期通信\nproxy-02,08:55,info,設定のリロード,ACL を再読み込み\nmail-01,09:11,low,フィッシングの隔離,添付 .iso を 27 通\nmail-01,08:48,info,スパム判定の更新,ルール定義を適用\ndns-01,09:02,low,DNS クエリの急増,通常比 8.4 倍\ndns-01,08:39,info,ゾーン転送の拒否,許可外 IP からの要求\" | search host=\"$sel_host$\" | table time severity event detail"
            },
            "name": "選択ホストの関連イベント"
        },
        "ds_chain": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"host,s,e,phase,detail\nweb-01,-118,-112,Recon,ポートスキャン\nweb-01,-101,-96,Initial Access,SQLi 試行\nweb-01,-84,-70,Execution,Web シェル配置\nvpn-01,-95,-88,Initial Access,総当たりログイン\nvpn-01,-86,-74,Credential Access,認証情報の窃取\napp-02,-72,-64,Lateral Movement,SMB 経由の横展開\napp-02,-63,-50,Privilege Escalation,権限昇格の試行\ndb-03,-48,-40,Collection,大量クエリの実行\ndb-03,-38,-24,Exfiltration,外部への転送\nfile-04,-26,-14,Impact,ファイル暗号化の兆候\nproxy-02,-58,-44,Command and Control,C2 ビーコン様の通信\nmail-01,-108,-100,Initial Access,フィッシングの受信\" | eval start=now()+s*60, end=now()+e*60 | table host start end phase detail"
            },
            "name": "攻撃チェーン"
        },
        "ds_map": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"srcName,srcLat,srcLon,dstName,dstLat,dstLon,severity,count\nBeijing CN,39.90,116.40,Tokyo DC,35.68,139.76,critical,842\nMoscow RU,55.75,37.61,Tokyo DC,35.68,139.76,critical,631\nSao Paulo BR,-23.55,-46.63,Tokyo DC,35.68,139.76,high,317\nLagos NG,6.52,3.37,Osaka DC,34.69,135.50,high,254\nAmsterdam NL,52.37,4.90,Osaka DC,34.69,135.50,medium,188\nMumbai IN,19.07,72.87,Tokyo DC,35.68,139.76,medium,142\nSeoul KR,37.56,126.97,Tokyo DC,35.68,139.76,low,97\nFrankfurt DE,50.11,8.68,Osaka DC,34.69,135.50,low,63\" | table srcName srcLat srcLon dstName dstLat dstLon severity count"
            },
            "name": "攻撃元の地理分布"
        },
        "ds_flow": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"src,dst,value\nインターネット,web-01,842\nインターネット,vpn-01,631\nインターネット,mail-01,254\nweb-01,app-02,412\nvpn-01,app-02,288\nmail-01,app-02,97\napp-02,db-03,355\napp-02,file-04,214\ndb-03,外部への転送,181\nfile-04,暗号化の実行,142\" | table src dst value"
            },
            "name": "侵害の流れ"
        },
        "ds_sevmix": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"severity,count\ncritical,18\nhigh,47\nmedium,96\nlow,152\ninfo,63\" | table severity count"
            },
            "name": "深刻度の内訳"
        },
        "ds_rules": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"rule,count\nSQLi 試行の遮断,214\n総当たりログイン,183\nポートスキャン,146\n不審な外部通信,118\nフィッシングの隔離,92\n権限昇格の試行,64\nSMB 経由の横展開,41\nランサム挙動の検知,18\" | table rule count"
            },
            "name": "検知ルール別の件数"
        },
        "ds_kpi_alerts": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n03時,241\n06時,268\n09時,297\n12時,312\n15時,334\n18時,351\n21時,363\n00時,376\" | table label value"
            },
            "name": "総アラート数"
        },
        "ds_kpi_crit": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n03時,6\n06時,7\n09時,9\n12時,11\n15時,13\n18時,15\n21時,17\n00時,18\" | table label value"
            },
            "name": "重大アラート"
        },
        "ds_kpi_hosts": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n03時,3\n06時,4\n09時,4\n12時,5\n15時,6\n18時,7\n21時,8\n00時,8\" | table label value"
            },
            "name": "影響ホスト数"
        },
        "ds_kpi_blocked": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n03時,152\n06時,171\n09時,188\n12時,203\n15時,217\n18時,228\n21時,236\n00時,241\" | table label value"
            },
            "name": "自動遮断"
        },
        "ds_kpi_risk": {
            "type": "ds.search",
            "options": {
                "query": "| makeresults format=csv data=\"label,value\n03時,48\n06時,52\n09時,57\n12時,61\n15時,64\n18時,67\n21時,69\n00時,70\" | table label value"
            },
            "name": "平均リスクスコア"
        }
    },
    "visualizations": {
        "md_header": {
            "type": "splunk.markdown",
            "options": {
                "markdown": "# 🛡 SOC インシデント調査コンソール\n##### アラートキューの行を **クリック** すると、右の調査ペインと下の関連イベントがそのホストに切り替わります",
                "fontColor": "#e8edf7",
                "backgroundColor": "transparent"
            }
        },
        "viz_kpi_alerts": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "dataSources": {
                "primary": "ds_kpi_alerts"
            },
            "options": {
                "backgroundColor": "transparent",
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "総アラート数 / 24H",
                "deltaLabel": "3時間前比",
                "accentColor": "#38bdf8",
                "iconName": "bell",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaColorMode": "positiveBad",
                "sparkMode": "line",
                "valueDecimals": 0,
                "bgOpacity": 18
            }
        },
        "viz_kpi_crit": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "dataSources": {
                "primary": "ds_kpi_crit"
            },
            "options": {
                "backgroundColor": "transparent",
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "重大アラート",
                "deltaLabel": "3時間前比",
                "accentColor": "#ef4d6a",
                "iconName": "fire",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaColorMode": "positiveBad",
                "sparkMode": "bars",
                "valueDecimals": 0,
                "bgOpacity": 18
            }
        },
        "viz_kpi_hosts": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "dataSources": {
                "primary": "ds_kpi_hosts"
            },
            "options": {
                "backgroundColor": "transparent",
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "影響ホスト",
                "deltaLabel": "3時間前比",
                "accentColor": "#f5c518",
                "iconName": "server",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaColorMode": "positiveBad",
                "sparkMode": "bars",
                "valueDecimals": 0,
                "bgOpacity": 18
            }
        },
        "viz_kpi_blocked": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "dataSources": {
                "primary": "ds_kpi_blocked"
            },
            "options": {
                "backgroundColor": "transparent",
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "自動遮断",
                "deltaLabel": "3時間前比",
                "accentColor": "#2dd4bf",
                "iconName": "shield",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaColorMode": "positiveGood",
                "sparkMode": "line",
                "valueDecimals": 0,
                "bgOpacity": 18
            }
        },
        "viz_kpi_risk": {
            "type": "custom_viz_kpi_tile.custom_viz_kpi_tile",
            "dataSources": {
                "primary": "ds_kpi_risk"
            },
            "options": {
                "backgroundColor": "transparent",
                "labelField": "> primary | seriesByName('label')",
                "valueField": "> primary | seriesByName('value')",
                "titleText": "平均リスクスコア",
                "deltaLabel": "3時間前比",
                "accentColor": "#8b7cf6",
                "iconName": "pulse",
                "showIcon": true,
                "showGlow": true,
                "showDelta": true,
                "deltaColorMode": "positiveBad",
                "sparkMode": "line",
                "valueDecimals": 0,
                "bgOpacity": 18
            }
        },
        "viz_queue": {
            "type": "custom_viz_severity_table.custom_viz_severity_table",
            "title": "アラートキュー（行をクリックして調査）",
            "dataSources": {
                "primary": "ds_alerts"
            },
            "options": {
                "backgroundColor": "transparent",
                "severityField": "> primary | seriesByName('severity')",
                "maxRows": 0,
                "sortMode": "desc",
                "cellStyle": "pill",
                "rowBar": true,
                "zebra": true,
                "compact": false,
                "showSummary": true,
                "summaryLabelMode": "canonical",
                "topIcon": "highest",
                "enableDrilldown": true,
                "title": ""
            },
            "eventHandlers": [
                {
                    "type": "drilldown.setToken",
                    "options": {
                        "tokens": [
                            {
                                "token": "sel_host",
                                "key": "row.host.value"
                            },
                            {
                                "token": "sel_rule",
                                "key": "row.rule.value"
                            },
                            {
                                "token": "sel_sev",
                                "key": "row.severity.value"
                            }
                        ]
                    }
                }
            ]
        },
        "viz_host_gauge": {
            "type": "custom_viz_gauge_arc.custom_viz_gauge_arc",
            "title": "$sel_host$ のリスクスコア",
            "dataSources": {
                "primary": "ds_risk"
            },
            "options": {
                "backgroundColor": "transparent",
                "valueField": "> primary | seriesByName('score')",
                "labelField": "> primary | seriesByName('_time')",
                "aggMode": "last",
                "minValue": 0,
                "maxValue": 100,
                "gaugeStyle": "segmented",
                "sweepAngle": 240,
                "arcThickness": 16,
                "segmentCount": 32,
                "litMode": "band",
                "showTrack": true,
                "showGlow": true,
                "showTicks": true,
                "showRangeLabels": true,
                "showBoundaryValues": true,
                "animate": true,
                "colorMode": "band",
                "colorBands": [
                    {
                        "from": null,
                        "to": 40,
                        "value": "#2dd4bf"
                    },
                    {
                        "from": 40,
                        "to": 70,
                        "value": "#f5c518"
                    },
                    {
                        "from": 70,
                        "to": 85,
                        "value": "#ff9f45"
                    },
                    {
                        "from": 85,
                        "to": null,
                        "value": "#ef4d6a"
                    }
                ],
                "titleText": "RISK SCORE",
                "unitText": "",
                "decimals": 0,
                "showTitle": true,
                "compareMode": "fixed",
                "compareValue": 58,
                "deltaLabel": "全社平均比",
                "goodDirection": "down",
                "showDelta": true,
                "panelPosition": "right",
                "panelWidth": 0.42,
                "slot1": "delta",
                "slot2": "sparkline",
                "slot3": "target",
                "slot4": "none",
                "targetValue": 70,
                "showTarget": true
            }
        },
        "viz_host_radar": {
            "type": "custom_viz_radar_chart.custom_viz_radar_chart",
            "title": "$sel_host$ のリスク内訳（全社平均との比較）",
            "dataSources": {
                "primary": "ds_radar"
            },
            "options": {
                "backgroundColor": "transparent",
                "axisField": "ドメイン",
                "seriesFields": [
                    "選択ホスト",
                    "全社平均"
                ],
                "seriesColors": [
                    "#ef4d6a",
                    "#38bdf8"
                ],
                "fillOpacity": 26,
                "strokeWidth": 2,
                "rings": 5,
                "startAngle": -90,
                "sharedScale": true,
                "showDots": true,
                "showAxisLabels": true,
                "showValueLabels": false,
                "showLegend": true,
                "glow": true
            }
        },
        "viz_chain": {
            "type": "custom_viz_timeline_swimlane.custom_viz_timeline_swimlane",
            "title": "攻撃チェーン（ホスト別・MITRE 戦術で色分け）",
            "dataSources": {
                "primary": "ds_chain"
            },
            "options": {
                "backgroundColor": "transparent",
                "laneField": "> primary | seriesByName('host')",
                "startField": "> primary | seriesByName('start')",
                "endField": "> primary | seriesByName('end')",
                "categoryField": "> primary | seriesByName('phase')",
                "labelField": "> primary | seriesByName('detail')",
                "autoLaneHeight": true,
                "showLaneLabels": true,
                "showLaneCount": true,
                "showAxis": true,
                "showGrid": true,
                "showLegend": true,
                "showCrosshair": true,
                "showNowLine": true,
                "enableBrush": true,
                "animate": true
            }
        },
        "viz_map": {
            "type": "custom_viz_worldmap.custom_viz_worldmap",
            "title": "攻撃元 → データセンター",
            "dataSources": {
                "primary": "ds_map"
            },
            "options": {
                "backgroundColor": "transparent",
                "srcLatField": "srcLat",
                "srcLonField": "srcLon",
                "dstLatField": "dstLat",
                "dstLonField": "dstLon",
                "srcNameField": "srcName",
                "dstNameField": "dstName",
                "countField": "count",
                "categoryField": "severity",
                "colorMode": "category",
                "categoryColors": [
                    "critical|#ef4d6a",
                    "high|#ff9f45",
                    "medium|#f5c518",
                    "low|#38bdf8"
                ],
                "categoryOrder": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                ],
                "fallbackColor": "#8b7cf6",
                "useBgColor": false,
                "useLandColor": true,
                "landColor": "#101a2e",
                "showTitle": false,
                "showLegend": true,
                "showFilter": false,
                "showHudStats": true,
                "labelLang": "ja",
                "animDuration": 3,
                "highlightOnHover": true
            }
        },
        "viz_flow": {
            "type": "custom_viz_sankey_flow.custom_viz_sankey_flow",
            "title": "侵害の流れ（侵入口 → 横展開 → 目的）",
            "dataSources": {
                "primary": "ds_flow"
            },
            "options": {
                "backgroundColor": "transparent",
                "useGradientLinks": true,
                "linkOpacity": 45,
                "lowColor": "#38bdf8",
                "midColor": "#f5c518",
                "highColor": "#ef4d6a",
                "useMidColor": true,
                "nodeWidth": 14,
                "nodePadding": 14,
                "showLabels": true,
                "showValues": true,
                "showHeader": false,
                "highlightOnHover": true,
                "colorMode": "scale"
            }
        },
        "viz_sevmix": {
            "type": "custom_viz_donut_graph.custom_viz_donut_graph",
            "title": "深刻度の内訳 / 24H",
            "dataSources": {
                "primary": "ds_sevmix"
            },
            "options": {
                "backgroundColor": "transparent",
                "categoryField": "severity",
                "valueField": "count",
                "seriesColors": [
                    "#ef4d6a",
                    "#ff9f45",
