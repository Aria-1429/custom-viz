        "test": "node test/colorRules.test.mjs && node test/scale.test.mjs && node test/spl.test.mjs && node test/timeBrush.test.mjs && node test/groups.test.mjs && node test/groupSurface.test.mjs && node test/history.test.mjs && node test/themes.test.mjs && node test/importDefinition.test.mjs && node test/backgrounds.test.mjs && node test/handDrawn.test.mjs",
        "notices": "cross-env NODE_ENV=production webpack --mode=production --json > /tmp/dpx-stats.json && WEBPACK_STATS=/tmp/dpx-stats.json node ../../scripts/gen-third-party-notices.mjs"
    },
